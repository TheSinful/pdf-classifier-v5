{"nodes": [{"id": "docs_classifier_main", "label": "Classifier Design Notes (main)", "file_type": "document", "source_file": "docs/classifier/main.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_classifier_main_inference_vs_classification", "label": "Inference vs Classification", "file_type": "concept", "source_file": "docs/classifier/main.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inference is the cheap sequential model weighing constraints; classification is the expensive ground truth kept off the inference thread."}, {"id": "docs_classifier_main_deferred_block", "label": "Deferred Block", "file_type": "concept", "source_file": "docs/classifier/main.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When a breaking object fails classification, subsequent dependent pages are poisoned; store them as a deferred block until the next independent object, then re-infer the block relative to the actual result."}, {"id": "docs_classifier_main_breaking_objects", "label": "Breaking vs Non-Breaking Objects", "file_type": "concept", "source_file": "docs/classifier/main.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A safer model guesses the non-breaking option (e.g. diagram over subchapter) because a wrong breaking guess invalidates downstream inference."}], "edges": [{"source": "docs_classifier_log_reg_dynamic_weights", "target": "docs_classifier_main_breaking_objects", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/classifier/main.md", "source_location": null, "weight": 1.0}, {"source": "docs_classifier_main", "target": "docs_classifier_main_inference_vs_classification", "relation": "references", "confidence": "EXT