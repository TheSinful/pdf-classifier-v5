{"nodes": [{"id": "github_copilot_instructions", "label": "PDF Classifier v5 AI Agent Instructions", "file_type": "document", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_copilot_instructions_constraint_based_sequence_labeling", "label": "Constraint-Based Speculative Sequence Labeling", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The engine is parsing / constraint satisfaction / sequence labeling, not ML: no model, no training, no learned weights. 'Inference' means constraint-driven deduction and scoring is a fixed linear tally; any change that looks like learned weights should stop."}, {"id": "github_copilot_instructions_guess_then_validate", "label": "Speculative Guess, Selective Classify Validation", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ground-truth classify() calls user C++ that pokes MuPDF and is expensive, so the engine guesses each page's type cheaply on the main thread from context + constraints and only fires classify() for the single top guess, in parallel off-thread."}, {"id": "github_copilot_instructions_deferral_recovery", "label": "Deferral Recovery (Forward Anchoring)", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A wrong guess poisons running structural context; instead of snapshot-and-rollback the engine scans forward to the next independent anchor and backfills the gap structurally, giving linear-time recovery with no exponential backtracking and no per-page context snapshots."}, {"id": "github_copilot_instructions_three_language_split", "label": "Three-Language Split (Python / C++ / Rust)", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each language exists because of an orthogonal hard constraint: Python for schema reflection and the DSL, C++ for MuPDF's C ABI and thread-affine contexts, Rust for safe parallel scheduling and the state machine. Collapsing any two layers violates one of those constraints."}, {"id": "github_copilot_instructions_inference_layer", "label": "Inference Layer (cheap, speculative, main-thread)", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L105", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fast, reversible and allowed to be wrong; kept separate from classification so expensive work never blocks guessing."}, {"id": "github_copilot_instructions_classification_extraction_layer", "label": "Classification/Extraction Layer (expensive, authoritative)", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L112", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_copilot_instructions_context_layer", "label": "Context Layer (structural state)", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L120", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds current_parent, decided pages, prev_parents and guarantee_failures; it informs inference but never decides."}, {"id": "github_copilot_instructions_four_tier_constraint_pipeline", "label": "Four-Tier Constraint Pipeline", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L125", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered Definitive -> Hard -> Soft -> Overrides. Tiers must not be mixed: no scoring in hard constraints, no filtering in soft ones."}, {"id": "github_copilot_instructions_definitive_constraints", "label": "Tier 1 Definitive Constraints", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L137", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_copilot_instructions_hard_constraints", "label": "Tier 2 Hard Constraints", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L141", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_copilot_instructions_soft_constraints", "label": "Tier 3 Soft Constraints", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Score budget is intentionally kept around 1.2-1.5 to leave room for future constraints."}, {"id": "github_copilot_instructions_overrides", "label": "Tier 4 Overrides (Override / OverrideStream)", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L159", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OverrideStream bypasses hierarchy inference across a recognized structural run so the engine avoids entering deferral for a known-shaped region."}, {"id": "github_copilot_instructions_static_constraint_dispatch", "label": "Static Constraint Dispatch (impl_constraint_enum!)", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proc macro generates a matching enum with direct dispatch: no vtables, no allocation, full inlining."}, {"id": "github_copilot_instructions_structural_lookup_tables", "label": "Structural Knowledge as O(1) Lookup Tables", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "L190", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schema relationships (VALID_CHILDREN, VALID_PARENTS, VALID_PAIRS, INDEPENDENTS) are compiled to adjacency matrices at build time to replace recursive tree walks with constant-time lookups."}, {"id": "github_copilot_instructions_independent_vs_dependent_objects", "label": "Independent vs Dependent Objects", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L209", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent (organizational) objects are safe anchors meaningful without prior context and terminate deferral/override-stream regions; dependent objects are only meaningful relative to a parent and unsafe to infer once context is poisoned."}, {"id": "github_copilot_instructions_classifier_state_machine", "label": "Classifier State Machine (Committed / Deferral / OverrideStream)", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L217", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deferral and OverrideStream classifiers wrap a CommittedClassifier as base so shared behavior lives in one place."}, {"id": "github_copilot_instructions_page_cursor_discipline", "label": "Page Cursor Discipline (PageLock)", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "L274", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Page advancement is enforced by a type because historically the worst bugs came from advancing the cursor in the wrong place (double-advances, skips)."}, {"id": "github_copilot_instructions_mupdf_thread_affinity", "label": "MuPDF Thread-Affine Contexts", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "L304", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MuPDF fz_context cannot cross threads, so every WorkerThread owns an isolated context + document."}, {"id": "github_copilot_instructions_worker_affine_extraction", "label": "Worker-Affine Extraction", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "L316", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The classify Shared payload holds MuPDF objects tied to the classifying worker's fz_context, so the auto-queued extract job must return to that same worker (re-queued if busy)."}, {"id": "github_copilot_instructions_opaque_ffi_boundary", "label": "Opaque FFI Boundary (cxx bridge)", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "L320", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw MuPDF types are never exposed across Rust<->C++; everything is an opaque wrapper (OpaqueCtx, OpaqueDoc, SharedData, OpaqueResult) with UniquePtr cleanup."}, {"id": "github_copilot_instructions_extraction_result_streaming", "label": "Extraction Result Streaming over TCP (Rust -> Python)", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L352", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The binary refuses to start without CLASSIFIER_OUTPUT_PORT because a result frontend is mandatory."}, {"id": "github_copilot_instructions_object_factory_dsl", "label": "ObjectFactory Fluent Schema DSL", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L364", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_copilot_instructions_build_pipeline", "label": "Python-Orchestrated Build Pipeline", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordering matters: Rust generated/ files and C++ headers must exist before cargo build; build.rs locates MuPDF and headers via CLASSIFIER_BUILD_DIR and links the user's classifier_intermediary."}, {"id": "github_copilot_instructions_generated_artifacts", "label": "Generated Rust/C++ Artifacts", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L401", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_copilot_instructions_known_incomplete_areas", "label": "Known Incomplete Areas", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L455", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deferral anchor scan can walk past a real anchor and pair parity is seeded without checking the last decision; OverrideAction::ClassifyAs is unused; Context has no rollback."}, {"id": "github_copilot_instructions_mupdf", "label": "MuPDF", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "github_copilot_instructions", "target": "github_copilot_instructions_constraint_based_sequence_labeling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/copilot-instructions.md", "source_location": null, "weight": 1.0}, {"source": "github_copilot_instructions", "target": "github_copilot_instructions_guess_then_validate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/copilot-instructions.md", "source_location": null, "weight": 1.0}, {"source": "github_copilot_instructions", "target": "github_copilot_instructions_deferral_recovery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/copilot-instructions.md", "source_location": null, "weight": 1.0}, {"source": "github_copilot_instructions", "target": "github_copilot_instructions_three_language_split", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/copilot-instructions.md", "source_location": null, "weight": 1.0}, {"source": "github_copilot_instructions", "target": "github_copilot_instructions_inference_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/copilot-instructions.md", "source_location": null, "weight": 1.0}, {"source": "github_copilot_instructions", "target": "github_copilot_instructions_classification_extraction_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/copilot-instructions.md", "source_location": null, "weight": 1.0}, {"source": "github_copilot_instructions", "target": "github_copilot_instructions_context_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/copilot-instructions.md", "source_location": null, "weight": 1.0}, {"source": "github_copilot_instructions", "target": "github_copilot_instructions_four_tier_constraint_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/copilot-instructions.md", "source_location": null, "weight": 1.0}, {"source": "github_copilot_instructions", "target": "github_copilot_instructions_structural_lookup_tables", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/copilot-instructions.md", "source_location": null, "weight": 1.0}, {"source": "github_copilot_instructions", "target": 